{
  "manifest_version": 3,
  "name": "Stream Sensation Analyzer",
  "version": "1.0.0",
  "description": "Real-time audio stream analyzer using AudioWorklet",
  "permissions": [
    "activeTab",
    "scripting",
    "offscreen",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "web_accessible_resources": [
    {
      "resources": ["dsp-engine/audio-worklet.js", "offscreen.html"],
      "matches": ["<all_urls>"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Stream Sensation Analyzer"
  }
}
