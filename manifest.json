{
  "manifest_version": 3,
  "name": "Stream Sensation Analyzer",
  "version": "1.3.1",
  "description": "Real-time audio stream analyzer using AudioWorklet",
  "permissions": [
    "activeTab",
    "scripting",
    "offscreen",
    "storage",
    "alarms",
    "sidePanel",
    "tabs"
  ],
  "side_panel": {
    "default_path": "popup/popup.html"
  },
  "host_permissions": [],
  "background": {
    "service_worker": "background.js"
  }
}
