{
  "manifest_version": 3,
  "name": "Stream Sensation Analyzer",
  "version": "1.3.0",
  "description": "Real-time audio stream analyzer using AudioWorklet",
  "permissions": [
    "activeTab",
    "scripting",
    "offscreen",
    "storage",
    "alarms",
    "tabCapture"
  ],
  "host_permissions": [],
  "web_accessible_resources": [
    {
      "resources": ["dsp-engine/audio-worklet.js", "dsp-engine/delay-processor.js"],
      "matches": ["<current_page>"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Stream Sensation Analyzer"
  }
}
