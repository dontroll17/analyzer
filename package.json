{
  "name": "ssa-tests",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "npx vitest run",
    "test:unit": "npx vitest run",
    "test:unit:watch": "npx vitest",
    "test:e2e": "npx playwright test",
    "test:e2e:ui": "npx playwright test --ui",
    "test:e2e:headed": "npx playwright test --headed",
    "test:e2e:worklet": "npx playwright test worklet-performance",
    "test:e2e:metrics": "npx playwright test metrics-protocol",
    "test:e2e:fake-audio": "npx playwright test fake-audio-capture",
    "test:e2e:sw": "npx playwright test sw-lifecycle",
    "test:e2e:memory": "npx playwright test memory-stability",
    "test:e2e:stress": "npx playwright test --grep @stress",
    "generate:fixtures": "python tests/e2e/fixtures/generate-audio.py",
    "test:coverage": "npx vitest run --coverage",
    "test:all": "npm test && npm run test:e2e",
    "validate": "node scripts/validate.js",
    "lint:logs": "node scripts/lint-logs.js",
    "lint:api": "node scripts/validate.js --check=api",
    "check:syntax": "node --check background.js content.js offscreen.js logger.js dsp-engine/audio-worklet.js dsp-engine/delay-processor.js dsp-engine/rms.js popup/popup.js popup/config.js",
    "scheduler:run": "node scripts/scheduler/run-all.js",
    "scheduler:analyze": "node scripts/scheduler/analyze-results.js",
    "scheduler:generate": "node scripts/scheduler/generate-tasks.js",
    "scheduler:all": "node scripts/scheduler/run-all.js && node scripts/scheduler/analyze-results.js",
    "scheduler:history": "node scripts/scheduler/analyze-results.js --compare-history",
    "scheduler:quick": "node --check background.js content.js offscreen.js logger.js && npm test -- --silent"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@vitest/coverage-v8": "^3.2.7",
    "jsdom": "^25.0.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.6"
  },
  "overrides": {
    "brace-expansion": "^1.1.17"
  }
}
